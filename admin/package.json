{
  "name": "fund-admin",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --no-warnings server/index.mjs",
    "dev:web": "vite",
    "build": "vite build",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File serve-lan.ps1",
    "start:local": "node --no-warnings server/index.mjs",
    "start:lan": "powershell -NoProfile -ExecutionPolicy Bypass -File serve-lan.ps1"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.9.1",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.2.1",
    "concurrently": "^9.1.2",
    "vite": "^6.0.5"
  }
}
